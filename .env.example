# Safe to expose to the browser. Row Level Security is what protects the data.
# Create a project at https://supabase.com/dashboard and copy these from Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy names still work if you have not rotated keys yet.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC. The Next app does not read this;
# Edge Functions take the secret from the Supabase runtime, not from this file.
# SUPABASE_SECRET_KEY=sb_secret_...
